# =============================================================================
# Drupal 11 + DDEV — production-ready .gitignore
# =============================================================================
# Track: .ddev/config.yaml, custom code, composer.lock, config/sync, settings.php
# Ignore: Composer deps, uploads, secrets, local overrides, IDE/OS junk, caches
# DDEV also maintains .ddev/.gitignore for generated/local-only DDEV files.
# =============================================================================

# -----------------------------------------------------------------------------
# Composer
# -----------------------------------------------------------------------------
/vendor/

# -----------------------------------------------------------------------------
# Drupal core & contrib (installed via Composer)
# -----------------------------------------------------------------------------
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# -----------------------------------------------------------------------------
# Drupal public/private files & PHPUnit / BrowserTest output (generated, not source)
# -----------------------------------------------------------------------------
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/tmp/
/web/sites/simpletest/
/private/

# -----------------------------------------------------------------------------
# Local / environment secrets & overrides
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

/web/sites/*/settings.local.php
/web/sites/*/services.local.yml

# Generated by DDEV on start (regenerate with `ddev start`)
/web/sites/*/settings.ddev.php
/web/sites/*/drushrc.php

# -----------------------------------------------------------------------------
# DDEV — keep project config in Git; ignore local-only overrides
# (Most DDEV-generated ignores live in .ddev/.gitignore)
# -----------------------------------------------------------------------------
.ddev/config.local.yaml
.ddev/config.*.local.yaml
.ddev/db_snapshots/
.ddev/.dbimageBuild/
.ddev/.webimageBuild/
.ddev/.homeadditions/
.ddev/.ddev-docker-compose-*.yaml
.ddev/mutagen/.start-synced
.ddev/traefik/certs/
.ddev/traefik/config/*.yaml

# -----------------------------------------------------------------------------
# Caches
# -----------------------------------------------------------------------------
.phpunit.result.cache
.php-cs-fixer.cache
.phpstan.cache
.phpstan.neon.local
/web/sites/*/files/php/
/web/sites/*/files/css/
/web/sites/*/files/js/
/web/sites/*/files/styles/
/web/sites/*/files/languages/
/web/sites/*/files/translations/
*.cache

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
/log/
/web/sites/*/files/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# Database dumps & archives (never commit)
# -----------------------------------------------------------------------------
*.sql
*.sql.gz
*.mysql
*.dump
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
!/.gitattributes

# -----------------------------------------------------------------------------
# IDE / editors
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
nbproject/
.project
.classpath
.settings/
*.iml

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Frontend tooling (not used; ignore if created accidentally)
# -----------------------------------------------------------------------------
/node_modules/
/package-lock.json
/yarn.lock
/pnpm-lock.yaml
/.npm/
/.yarn/
