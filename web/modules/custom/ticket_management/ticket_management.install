<?php

/**
 * @file
 * Install, update, and uninstall functions for Ticket Management.
 */

declare(strict_types=1);

use Drupal\user\Entity\Role;
use Drupal\user\Entity\User;

/**
 * Implements hook_install().
 */
function ticket_management_install(): void {
  ticket_management_seed_demo_users();
}

/**
 * Installs entity types if missing and seeds demo users.
 *
 * Apply with: ddev drush updb -y
 */
function ticket_management_update_9001(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager->clearCachedDefinitions();

  foreach (['ticket', 'ticket_comment'] as $entity_type_id) {
    if ($definition_update_manager->getEntityType($entity_type_id) === NULL) {
      $entity_type = $entity_type_manager->getDefinition($entity_type_id);
      $definition_update_manager->installEntityType($entity_type);
    }
  }

  ticket_management_seed_demo_users();
}

/**
 * Adds indexes on ticket.status and ticket.created for the list query.
 *
 * Apply with: ddev drush updb -y
 */
function ticket_management_update_9002(): void {
  \Drupal::entityDefinitionUpdateManager()
    ->updateEntityType(\Drupal::entityTypeManager()->getDefinition('ticket'));
}

/**
 * Creates the ticket_agent role and five demo users (idempotent).
 *
 * Seed reference copy: ai-practical-assessment/database/seed-data/
 *
 * @return array<string, int|null>
 *   Map of username => uid (null if creation failed).
 */
function ticket_management_seed_demo_users(): array {
  $role_id = 'ticket_agent';
  if (!Role::load($role_id)) {
    $role = Role::create([
      'id' => $role_id,
      'label' => 'Ticket agent',
    ]);
    $permissions = [
      'access ticket overview',
      'view ticket',
      'create ticket',
      'edit ticket',
      'transition ticket status',
      'create ticket comment',
      'access user profiles',
    ];
    foreach ($permissions as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }

  $demo_users = [
    [
      'name' => 'ticket_admin',
      'mail' => 'ticket.admin@example.com',
      'roles' => ['administrator'],
    ],
    [
      'name' => 'agent_alice',
      'mail' => 'alice.agent@example.com',
      'roles' => [$role_id],
    ],
    [
      'name' => 'agent_bob',
      'mail' => 'bob.agent@example.com',
      'roles' => [$role_id],
    ],
    [
      'name' => 'requester_carol',
      'mail' => 'carol.requester@example.com',
      'roles' => [$role_id],
    ],
    [
      'name' => 'requester_dave',
      'mail' => 'dave.requester@example.com',
      'roles' => [$role_id],
    ],
  ];

  $created = [];
  $storage = \Drupal::entityTypeManager()->getStorage('user');
  foreach ($demo_users as $info) {
    $existing_users = $storage->loadByProperties(['name' => $info['name']]);
    $existing = $existing_users ? reset($existing_users) : NULL;
    if ($existing) {
      $created[$info['name']] = (int) $existing->id();
      continue;
    }

    $user = User::create([
      'name' => $info['name'],
      'mail' => $info['mail'],
      'status' => 1,
      'pass' => 'TicketDemo!23',
    ]);
    foreach ($info['roles'] as $rid) {
      if (Role::load($rid)) {
        $user->addRole($rid);
      }
      elseif (Role::load($role_id)) {
        $user->addRole($role_id);
      }
    }
    $user->save();
    $created[$info['name']] = (int) $user->id();
  }

  return $created;
}
